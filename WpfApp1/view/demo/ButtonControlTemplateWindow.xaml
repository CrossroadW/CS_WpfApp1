<Window
    x:Class="WpfApp1.view.demo.ButtonControlTempalteWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WpfApp1.view.demo"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="ButtonControlTempalteWindow"
    Width="800"
    Height="450"
    Background="White"
    mc:Ignorable="d">
    <Window.Resources>
        <ControlTemplate x:Key="customButtonTemplate" TargetType="Button">
            <Border BorderBrush="Red" BorderThickness="{TemplateBinding BorderThickness}">
                <Grid>
                    <!--  按钮内容  -->
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <!--  左上角 ♥  -->
                    <TextBlock
                        Margin="2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Foreground="Red"
                        Text="♥" />
                </Grid>
            </Border>
        </ControlTemplate>

    </Window.Resources>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Button
            Width="auto"
            Height="auto"
            MinHeight="100"
            BorderThickness="5"
            Content="控制按钮外观"
            FontSize="20"
            Template="{StaticResource customButtonTemplate}" />
    </StackPanel>

</Window>
